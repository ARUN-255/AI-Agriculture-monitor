SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
DEVICE_TOKEN=replace-with-a-long-random-secret
# Local Docker default. To publish laptop simulator readings to Render, set this to
# https://agri-guard-api.onrender.com and use the SAME DEVICE_TOKEN configured on Render.
API_BASE_URL=https://agri-guard-api.onrender.com
# Comma-separated browser origins. Add your deployed dashboard URL when hosting it.
CORS_ORIGINS=http://localhost:5173
SIMULATOR_USER_ID=
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_URL=http://localhost:8000
ENABLE_ML=false
